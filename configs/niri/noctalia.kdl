layout {

    focus-ring {
        active-color   "#a9d473"
        inactive-color "#121410"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a9d473"
        inactive-color "#121410"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a9d473"
        inactive-color "#304f00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a9d47380"
    }
}

recent-windows {
    highlight {
        active-color "#a9d473"
        urgent-color "#ffb4ab"
    }
}
